<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterCliente.master.cs" Inherits="Ecommerce.MasterCliente" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>EcommerceCliente</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body>
    <form id="frmMasterCliente" runat="server">
        <nav class="navbar bg-info">
            <div class="container-fluid">
                <a class="navbar-brand" href="/DefaultCliente.aspx">Ecommerce</a>
                <div class="justify-content-end">
                    <a class="me-3" href="/Carrito.aspx">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="dark" class="bi bi-cart2" viewBox="0 0 16 16">
                            <path d="M0 2.5A.5.5 0 0 1 .5 2H2a.5.5 0 0 1 .485.379L2.89 4H14.5a.5.5 0 0 1 .485.621l-1.5 6A.5.5 0 0 1 13 11H4a.5.5 0 0 1-.485-.379L1.61 3H.5a.5.5 0 0 1-.5-.5M3.14 5l1.25 5h8.22l1.25-5zM5 13a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0m9-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0" />
                        </svg>
                    </a>
                    <a class="nav-link" href="RegistroVendedor.aspx">Quiero Vender!</a>
                    <asp:Image ID="imgPerfil" CssClass="rounded-circle" Width="55px" Height="55px" runat="server" />
                </div>
            </div>
        </nav>
        <div class="container">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer class="p-1" style="background-color: #299abc">
            <div class="container">
                <br />
                <div class="row">
                    <div class="col">
                        <h2>Informacion</h2>
                        <ul>
                            <li><a href="#">Inicio</a></li>
                            <li><a href="#">Contacto</a></li>
                        </ul>
                    </div>
                    <div class="col">
                        <h2>Redes</h2>
                        <ul>
                            <li><a href="#">content</a></li>
                            <li><a href="#">content</a></li>
                        </ul>
                    </div>
                    <div class="col">
                        <h2>¿Donde estamos?</h2>
                        <p>
                            UBICACION
                        <br />
                            <a href="#">content</a>
                            <br />
                            <a href="#">content</a>
                            <br />
                            HORARIO
                        </p>
                    </div>
                    <div class="col">
                        <h2>Newsletter</h2>
                        <p>¡¡Recibi promociones en tu email!!</p>

                    </div>

                </div>
                <hr />
                <div class="text-center">
                    <p>© 2026 UTN Equipo 13B - Todos los derechos reservados.</p>
                </div>
            </div>
        </footer>
    </form>
</body>
</html>
